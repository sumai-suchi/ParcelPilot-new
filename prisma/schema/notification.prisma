model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  shipmentId String?   @map("shipment_id") @db.Uuid
  title      String    @db.VarChar(255)
  message    String    @db.Text
  type       String    @db.VarChar(50)
  isRead     Boolean   @default(false) @map("is_read")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_notifications_user")
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull, map: "fk_notifications_shipment")
  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}