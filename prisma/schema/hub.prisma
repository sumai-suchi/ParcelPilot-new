model Hub {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  code      String   @unique @db.VarChar(50)
  zoneId    String   @map("zone_id") @db.Uuid
  address   String   @db.Text
  phone     String?  @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  // Relations
  zone                 Zone          @relation(fields: [zoneId], references: [id], onDelete: Restrict, map: "fk_hubs_zone")
  couriers             Courier[]
  originShipments      Shipment[]    @relation("OriginHubShipments")
  destinationShipments Shipment[]    @relation("DestinationHubShipments")
  transfersFrom        HubTransfer[] @relation("TransfersFromHub")
  transfersTo          HubTransfer[] @relation("TransfersToHub")
  roleApplications     RoleApplication[]
  @@map("hubs")
}