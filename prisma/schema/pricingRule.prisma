model PricingRule {
  id           String   @id @default(uuid()) @db.Uuid
  zoneId       String   @map("zone_id") @db.Uuid
  deliveryType String   @default("STANDARD") @map("delivery_type") @db.VarChar(50)
  minWeight    Decimal  @default(0.00) @map("min_weight") @db.Decimal(8, 2)
  maxWeight    Decimal  @map("max_weight") @db.Decimal(8, 2)
  baseCharge   Decimal  @map("base_charge") @db.Decimal(10, 2)
  perKgCharge  Decimal  @default(0.00) @map("per_kg_charge") @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade, map: "fk_pricing_rules_zone")
  @@map("pricing_rules")
}